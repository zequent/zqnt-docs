# =======================================================================
# ZEQUENT PLATFORM — CUSTOMER DEPLOYMENT ENVIRONMENT TEMPLATE
#
# This is a TEMPLATE, not a working .env — every <PLACEHOLDER> below must be
# filled in before use, and it must be copied/renamed to plain ".env" in the
# same directory as docker-compose.customer.yml (each service's `env_file:`
# reads a literal ".env" — it is not affected by `docker compose --env-file`,
# and docker-compose.customer.yml only ever loads ".env", never this file
# directly):
#
#   cp .env.customer .env
#   # edit .env, fill in every <PLACEHOLDER>
#   docker compose -f docker-compose.customer.yml up -d
#
# Do not commit the real .env you produce from this template — it will hold
# real secrets (DB/Redis passwords, your Ed25519 signing key, your license
# key). This template mirrors core/docs/.env.customer — keep both in sync.
#
# Nothing internal to Zequent is in here: no dev/CI credentials, no private
# package-registry tokens, no shared local-dev signing key, no local license
# hub. Every value below is either a safe structural default (container
# hostnames/ports that only make sense inside this exact Compose network) or
# a placeholder only you can fill in.
# =======================================================================

# --- Database and cache -------------------------------------------------
# Postgres/TimescaleDB and Redis, as wired by docker-compose.customer.yml's
# own "postgres"/"redis" services. Point every *_URL below at your own
# managed instances instead if you're not using the bundled containers.
# Always use the Compose service name + the container's *internal* port
# (5432/6379) here — never 127.0.0.1/localhost and never a host-mapped port
# like postgres's "5434:5432": from inside another container, 127.0.0.1
# means that container itself, not a sibling container.

POSTGRES_PASSWORD=<CHOOSE-A-STRONG-POSTGRES-PASSWORD>

DATABASE_URL=jdbc:postgresql://postgres:5432/zequent_db
DATABASE_REACTIVE_URL=postgresql://postgres:5432/zequent_db
DATABASE_USER=postgres
DATABASE_PASSWORD=<SAME-VALUE-AS-POSTGRES_PASSWORD-ABOVE>

REDIS_URL=redis://redis:6379

# --- Licensing ------------------------------------------------------------
# Every platform service enforces a license lease. Activation happens once,
# from the Admin Console, against the real Zequent license server (not a
# local license hub) — see core/docs/README.md#licensing.

LICENSING_INSTALLATION_ID=<A-STABLE-ID-FOR-THIS-DEPLOYMENT-e.g.-acme-prod>
LICENSING_LICENSE_KEY=<YOUR-LICENSE-KEY-FROM-ZEQUENT>
LICENSING_PUBLIC_KEY=<LICENSING-PUBLIC-KEY-PROVIDED-WITH-YOUR-LICENSE>
LICENSING_SIGNING_KEY_ID=<KEY-ID-PROVIDED-WITH-YOUR-LICENSE>
LICENSE_SERVER_URL=https://api.zequent.com
LICENSING_EXPECTED_ISSUER=https://api.zequent.com
LICENSING_EXPECTED_AUDIENCE=zqnt-framework
# Leave the Admin Console's license activation endpoint reachable until
# you've activated once, then optionally lock it down:
LICENSING_ACTIVATION_API_ENABLED=true
LICENSING_ACTIVATION_ID=
LICENSING_ACTIVATION_TOKEN=

# --- Authentication ---------------------------------------------------
# Every bearer token this deployment issues is signed with this Ed25519
# keypair. Generate your own — never reuse a value from any example/dev
# environment:
#
#   openssl genpkey -algorithm ed25519 -out auth-private.pem
#   openssl pkey -in auth-private.pem -pubout -out auth-public.pem
#   # then base64 the PKCS8/SubjectPublicKeyInfo DER (or PEM, stripped of
#   # headers/newlines) into the two variables below

AUTH_PRIVATE_KEY=<YOUR-GENERATED-ED25519-PRIVATE-KEY-BASE64-PKCS8>
AUTH_PUBLIC_KEY=<YOUR-GENERATED-ED25519-PUBLIC-KEY-BASE64-SPKI>
AUTH_ISSUER=<YOUR-COMPANY>-admin-console
AUTH_EXPECTED_ISSUER=<YOUR-COMPANY>-admin-console
AUTH_SYSTEM_ADMIN_EMAIL=<you@your-company.com>
# Only needed if an organization connects its own SSO/OIDC identity provider:
# OIDC_REDIRECT_URI=https://<your-dashboard-domain>/api/auth/callback

# --- Admin Console UI (dashboard) ---------------------------------------
# BACKEND_ORIGIN and LICENSE_API_ORIGIN are the UI container's own server-side
# proxy targets, read at runtime by its server.js — both silently default to
# "http://localhost:8005"/"http://localhost:4000" if unset, which inside that
# container resolves to the UI container itself, not admin-console-service,
# and produces a dashboard that loads but has no working backend connection.
# LICENSE_API_ORIGIN's :4000 default is a local zqnt-hub-api mock we don't
# run here — point it at the real license server instead.
BACKEND_ORIGIN=http://admin-console-service:8005
LICENSE_API_ORIGIN=https://api.zequent.com

# The NEXT_PUBLIC_* values are what the customer's browser calls directly, so
# they must be the public URL(s) this deployment is actually reachable at —
# localhost only works when you're opening the dashboard on this same
# machine as a single-machine demo.
ADMIN_CONSOLE_CORS_ORIGINS=<https://your-dashboard-domain.com>

NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8005
NEXT_PUBLIC_BACKEND_AUTH_API_HOST=http://localhost:8005
NEXT_PUBLIC_BACKEND_OPERATION_API_HOST=http://localhost:8005
NEXT_PUBLIC_BACKEND_SCHEDULER_API_HOST=http://localhost:8005
NEXT_PUBLIC_BACKEND_ASSET_API_HOST=http://localhost:8005
NEXT_PUBLIC_BACKEND_ORGANIZATION_API_HOST=http://localhost:8005
NEXT_PUBLIC_BACKEND_ASSET_WS_HOST=ws://localhost:8005
NEXT_PUBLIC_BACKEND_DRC_WS_HOST=ws://localhost:8005
NEXT_PUBLIC_BACKEND_NOTIFICATION_WS_HOST=ws://localhost:8005
# Replace every "localhost:8005" above with your real public hostname (and
# wss:// instead of ws:// behind TLS) once this isn't a local demo anymore.

# --- Load-test / fleet simulator (only used with --profile simulator) -----
# Structural values for talking to the other services in this same Compose
# network — leave as-is unless you've renamed a service.

CONNECTOR_ADDR=connector-service:8010
LIVE_DATA_ADDR=live-data-service:8003
MISSION_AUTONOMY_ADDR=mission-autonomy-service:8004
REDIS_ADDR=redis:6379
# Must resolve from inside remote-control-service's own container, not just
# from here:
ADVERTISE_ADDR=simulator:9190
DEVICE_SN=SIM-DRONE-001
# Keep the simulator's control API authenticated in a real deployment (it
# reuses the AUTH_PUBLIC_KEY/AUTH_EXPECTED_ISSUER set above). Only leave this
# false for a private/internal load-test run with no real customer data.
ZQNT_AUTH_ENABLED=true
# admin-console-service's %docker profile defaults this to "edge-simulator" (the
# service name in docker-compose.local.yml) — our simulator service in
# docker-compose.customer.yml is named "simulator", so this must be set
# explicitly or admin-console-service can't resolve it (DNS failure in its logs).
EDGE_SIMULATOR_CONTROL_SERVICE_HOST=simulator
EDGE_SIMULATOR_CONTROL_SERVICE_PORT=9191

# --- Edge adapters (only used with the matching --profile) ---------------
# Fill in whichever of these blocks you actually enable. Each adapter also
# needs EDGE_ADAPTER_TARGET_ENDPOINTS pointed at where the platform can
# reach it (its own host:port), plus its own device/broker credentials —
# see each adapter's deployment guide under core/docs/edge-sdk/.

# EDGE_ADAPTER_TARGET_ENDPOINTS=edge-dji:9001
# ZQNT_MQTT_BROKER_HOST=<your-dji-mqtt-broker-host>
# ZQNT_MQTT_USERNAME=<...>
# ZQNT_MQTT_PASSWORD=<...>
# ZQNT_MQTT_DOCK_USERNAME=<...>
# ZQNT_MQTT_DOCK_PASSWORD=<...>
